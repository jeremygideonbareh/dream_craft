---
// Renders a content image (bundled asset or admin upload) through Astro's
// optimiser, so uploads get resized WebP versions at build time too.
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, widths = [480, 800, 1200], sizes = '100vw', eager = false, class: cls } = Astro.props;
const img = resolveImage(src);
---
{img && (typeof img === 'string'
  ? <Image src={img} alt={alt} inferSize widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} class={cls} />
  : <Image src={img} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} class={cls} />)}
