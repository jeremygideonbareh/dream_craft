---
// "From the studio": every photo at once, as a mosaic wall. On laptops the
// section pins and the camera pulls back from one hero photo to reveal the
// whole wall. Motion lives in scripts/motion/home.ts (wall()).
import Pic from '../Pic.astro';
import { loadContent } from '../../content/load';
import { url } from '../../lib/images';
const { home, gallery } = await loadContent();
const g = home.gallery;
// the wall is designed to fit one screen, so it shows the first twelve;
// the Work page shows every photo
const items = gallery.filter((x) => x.visible).slice(0, 12);
---
<section class="gal" id="gallery">
  <div class="gal__pin" data-gal-pin>
    <div class="gal__head" data-gal-head>
      <h2 class="h-lg">{g.title} <span class="it">{g.titleAccent}</span></h2>
      <a href={url('work/')} class="link link--light magnetic" data-cursor="All">{g.link} <i>→</i></a>
    </div>
    <ul class="wall" data-wall>
      {items.map((x, i) => (
        <li class:list={['wall__tile', { 'wall__tile--hero': i === 0 }]} data-wall-tile>
          <a class="wall__link" href={url(`quote/?product=${x.product}&ref=${encodeURIComponent(x.id)}`)} data-cursor="Like this">
            <div class="wall__img" data-wall-img>
              <Pic src={x.image} alt={x.alt} widths={i === 0 ? [600, 1000, 1400] : [360, 640, 900]} sizes={i === 0 ? '(max-width: 900px) 92vw, 34vw' : '(max-width: 900px) 46vw, 17vw'} />
            </div>
            <span class="wall__cap"><b>{x.title}</b><em>{g.itemHint}</em></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
