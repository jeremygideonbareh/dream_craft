---
import { loadContent } from '../../content/load';
import { url } from '../../lib/images';
import { inr } from '../../lib/pricing';
import { fill } from '../../lib/site';
const { home, pricing } = await loadContent();
const h = home.packages;
const r = pricing.rules;
const L = pricing.labels;
---
<section class="sec pk" id="packages">
  <div class="wrap">
    <header class="sec__head sec__head--center">
      <p class="eyebrow" data-reveal="fade"><i></i>{h.eyebrow}</p>
      <h2 class="h-lg" data-split="chars">{h.title} <span class="it">{h.titleAccent}</span></h2>
      <p class="lede" data-split="words">{h.lede}</p>
    </header>
    <div class="pk__grid" data-reveal-group>
      {pricing.packages.map((p) => (
        <article class:list={['pk__card', { 'is-featured': p.featured }]} data-tilt>
          {p.featured && <span class="pk__tag">{pricing.featuredLabel}</span>}
          <h3>{p.name}</h3>
          <p class="pk__from">{L.starting}</p>
          <p class="pk__price">₹<span data-count={p.from}>{p.from.toLocaleString('en-IN')}</span></p>
          <p class="pk__qty">{fill(L.forQty, { qty: p.qty })}</p>
          <p class="pk__blurb">{p.blurb}</p>
          <a href={url(`quote/?product=invitations&tier=${p.id}`)} class:list={['btn btn--sm magnetic', p.featured ? 'btn--light' : 'btn--ghost']} data-cursor="Quote"><span>{fill(L.quoteButton, { name: p.name })}</span></a>
        </article>
      ))}
    </div>
    <ul class="pk__extras" data-reveal-group>
      <li class="chip">{fill(L.chipCustom, { price: inr(r.customFromPerInvite) })}</li>
      <li class="chip">{fill(L.chipFoilNames, { price: inr(r.foilNamesPerInvite) })}</li>
      <li class="chip">{fill(L.chipFoilFull, { price: inr(r.foilFullPerInvite) })}</li>
      <li class="chip">{fill(L.chipRush, { price: inr(r.rushPerInvite) })}</li>
      <li class="chip">{fill(L.chipBulk, { percent: r.bulkDiscountPercent, qty: r.bulkDiscountAbove })}</li>
    </ul>
    <p class="pk__note" data-reveal="fade">{pricing.disclaimer} <a href={url('pricing/')}>{h.fullPricingLink}</a></p>
  </div>
</section>
