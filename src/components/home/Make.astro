---
// "What we make": every product at once, as a grid that assembles itself as
// you scroll into it. Motion lives in scripts/motion/home.ts (catalog()).
import ProductArt from '../ProductArt.astro';
import { loadContent } from '../../content/load';
import { url } from '../../lib/images';
const { home, products } = await loadContent();
const m = home.make;
const list = products.filter((p) => p.visible);
// placeholder cards (no photo yet) get one of these tints in turn
const tints = ['#F3DDCD', '#E6E2CF', '#EFD9D2', '#E3E6DA', '#F2E3C9'];
---
<section class="sec make" id="make" data-bg="#FAF2E7">
  <div class="wrap">
    <header class="sec__head">
      <div>
        <p class="eyebrow" data-reveal="left"><i></i>{m.eyebrow}</p>
        <h2 class="h-lg" data-split="chars">{m.title} <span class="it">{m.titleAccent}</span></h2>
      </div>
      <p class="lede" data-split="words">{m.lede}</p>
    </header>

    <ul class="cat" data-catalog>
      {list.map((p, i) => (
        <li class="cat__item" data-cat-item>
          <a class="cat__card" href={url(`quote/?product=${p.id}`)} data-cursor="Quote" data-tilt
             style={p.images.length ? undefined : `--tint:${tints[i % tints.length]}`}>
            <div class:list={['cat__media', { 'cat__media--art': !p.images.length }]} data-cat-media>
              <div class="cat__zoom"><ProductArt product={p} sizes="(max-width: 600px) 46vw, (max-width: 1100px) 31vw, 19vw" /></div>
              {!p.images.length && <span class="cat__artname" aria-hidden="true">{p.short}</span>}
              <span class="cat__num">{String(i + 1).padStart(2, '0')}</span>
              <div class="cat__more" aria-hidden="true">
                <p>{p.blurb}</p>
                <span class="cat__go">Quote <svg viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" /></svg></span>
              </div>
            </div>
            <div class="cat__body">
              <h3>{p.title}</h3>
              <p class="cat__sub">{p.variants.length ? p.variants.map((v) => v.label).join(' · ') : `Made to order · per ${p.unit.replace(/s$/, '')}`}</p>
            </div>
            <span class="cat__tag" aria-hidden="true">Quote →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
