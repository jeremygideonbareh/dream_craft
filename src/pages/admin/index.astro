---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../../styles/admin.css';
import App from '../../admin/App.svelte';
import { loadContent } from '../../content/load';
import { url } from '../../lib/images';

// Previews for the photos bundled with the site, so the image picker can show
// them even though they aren't served from a public folder.
const { settings } = await loadContent();
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/*.{jpg,jpeg,png,webp}', { eager: true });
const previews: Record<string, string> = {};
for (const [path, mod] of Object.entries(files)) {
  previews[path.split('/').pop()!] = (await getImage({ src: mod.default, width: 320, format: 'webp' })).src;
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Studio panel | {settings.brand.display}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script type="application/json" id="assetPreviews" set:html={JSON.stringify(previews)}></script>
  <script type="application/json" id="brandInfo" set:html={JSON.stringify({ name: settings.brand.display, accent: settings.brand.wordmarkAccentLetter })}></script>
</head>
<body>
  <App client:only="svelte" />
</body>
</html>
