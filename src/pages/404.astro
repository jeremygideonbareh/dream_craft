---
// Shown for any address that doesn't exist, e.g. a mistyped link from Instagram.
// The wording is edited in the admin panel under Settings → Not found.
import Base from '../layouts/Base.astro';
import { loadContent } from '../content/load';
import { url } from '../lib/images';
const { settings } = await loadContent();
const n = settings.notFound;
---
<Base page="404" title={n.eyebrow} description={n.text}>
  <section class="phead">
    <div class="wrap">
      <p class="eyebrow" data-reveal="left"><i></i>{n.eyebrow}</p>
      <h1 class="h-lg" data-split="chars">{n.title}</h1>
      <p class="lede" data-split="words">{n.text}</p>
      <p style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px" data-reveal="up">
        <a href={url('/')} class="btn btn--quote"><span>{n.homeButton}</span></a>
        <a href={url('work/')} class="btn btn--ghost"><span>{n.workButton}</span></a>
      </p>
    </div>
  </section>
</Base>
