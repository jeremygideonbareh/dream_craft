---
// Shown for any address that doesn't exist, e.g. a mistyped link from Instagram.
import Base from '../layouts/Base.astro';
import { url } from '../lib/images';
---
<Base page="404" title="Page not found" description="This page doesn't exist. Browse our work or ask for a quote.">
  <section class="phead">
    <div class="wrap">
      <p class="eyebrow" data-reveal="left"><i></i>Page not found</p>
      <h1 class="h-lg" data-split="chars">This page wandered off.</h1>
      <p class="lede" data-split="words">The link may be old or mistyped. Everything we make is still here.</p>
      <p style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px" data-reveal="up">
        <a href={url('/')} class="btn btn--quote"><span>Go to the home page</span></a>
        <a href={url('work/')} class="btn btn--ghost"><span>See our work</span></a>
      </p>
    </div>
  </section>
</Base>
