---
import Base from './Base.astro';
import { loadContent } from '../content/load';
import { whatsappLink } from '../lib/site';
import { url } from '../lib/images';

interface Props {
  doc: { title: string; updated: string; intro: string; sections: { heading: string; body: string }[] };
  page: 'privacy' | 'terms';
}
const { doc, page } = Astro.props;
const { settings, legal } = await loadContent();

// A section body can hold several paragraphs (one per line) and bullet lists
// (lines starting with "- "), so long terms stay readable.
type Block = { list: false; text: string } | { list: true; items: string[] };
const blocks = (body: string) =>
  body.split(/\n+/).map((l) => l.trim()).filter(Boolean).reduce<Block[]>((out, line) => {
    const item = line.match(/^[-•]\s+(.*)$/);
    const last = out[out.length - 1];
    if (item) last?.list ? last.items.push(item[1]) : out.push({ list: true, items: [item[1]] });
    else out.push({ list: false, text: line });
    return out;
  }, []);
---
<Base page={page} title={doc.title} description={doc.intro.slice(0, 180)}>
  <section class="phead legal">
    <div class="wrap">
      <p class="eyebrow" data-reveal="left"><i></i>{doc.title}</p>
      <h1 class="h-lg" data-split="chars">{doc.title}</h1>
      <p class="legal__updated">Last updated {doc.updated}</p>
      <p class="lede" data-split="words">{doc.intro}</p>
    </div>
  </section>

  <section class="sec legal__body" style="padding-top:0">
    <div class="wrap">
      <div class="prose">
        {doc.sections.map((s) => (
          <section data-reveal="up">
            <h2 data-split="lines">{s.heading}</h2>
            {blocks(s.body).map((b) => (b.list ? <ul>{b.items.map((i) => <li>{i}</li>)}</ul> : <p>{b.text}</p>))}
          </section>
        ))}
        <p class="prose__contact">
          {legal.contactQuestion}
          <a href={whatsappLink(settings.contact)} target="_blank" rel="noopener">{legal.contactWhatsapp}</a>
          {settings.contact.email && <> {legal.contactOrEmail} <a href={`mailto:${settings.contact.email}`}>{settings.contact.email}</a></>}.
          <br />
          <a href={url(page === 'privacy' ? 'terms/' : 'privacy/')}>{page === 'privacy' ? legal.terms.title : legal.privacy.title} →</a>
        </p>
      </div>
    </div>
  </section>
</Base>
