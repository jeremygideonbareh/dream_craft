---
import '../styles/base.css';
import '../styles/sections.css';
import Wordmark from '../components/Wordmark.astro';
import { loadContent } from '../content/load';
import { whatsappLink, fill, WHATSAPP_ICON } from '../lib/site';
import { url } from '../lib/images';

const { settings, products, pricing } = await loadContent();
const { brand, contact, footer } = settings;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('og.png'), Astro.site);

const labels = settings.nav;
const nav = [
  { href: 'work/', label: labels.ourWork },
  { href: '#make', label: labels.whatWeMake },
  { href: 'pricing/', label: labels.packages },
  { href: '#process', label: labels.howItWorks },
];
const footProducts = products.filter((p) => p.visible).slice(0, 4);

interface Props {
  title?: string;
  description?: string;
  page: 'home' | 'work' | 'pricing' | 'quote' | 'privacy' | 'terms' | '404' | 'pay';
}
const { title, description: pageDescription = brand.description, page } = Astro.props;
// Google shows about 160 characters of a description; cut longer ones at a word
const clamp = (t: string, max = 158) => (t.length <= max ? t : t.slice(0, t.lastIndexOf(' ', max - 1)).replace(/[\s,;:.]+$/, '') + '…');
// wording set in the panel (Settings → Search engines) wins over the page's own
const seo = (settings.seo as Record<string, { title?: string; description?: string } | undefined> | undefined)?.[page];
const fullTitle = seo?.title?.trim() || (title ? `${title} | ${brand.display}` : `${brand.display}: ${brand.tagline}`);
const description = clamp(seo?.description?.trim() || pageDescription);
const googleVerification = settings.seo?.googleVerification?.trim();
const isHome = page === 'home';
const href = (h: string) => (h.startsWith('#') ? (isHome ? h : url('/' + h)) : url(h));
const current = (h: string) => (h.startsWith(page) ? 'page' : undefined);

// Structured data: who we are on the home page, and the questions we answer
// on the pricing page, so search engines can show them directly.
const jsonLd: Record<string, unknown>[] = [];
if (page === 'home') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: brand.display,
    // the name without its accent, and the old name, so searches for either find the studio
    alternateName: [...new Set([brand.display.normalize('NFD').replace(/\p{Diacritic}/gu, ''), brand.formerly])]
      .filter((n) => n && n !== brand.display),
    description: brand.description,
    url: Astro.site?.toString(),
    image: ogImage.toString(),
    '@id': new URL('#business', Astro.site).toString(),
    address: {
      '@type': 'PostalAddress',
      streetAddress: contact.streetAddress || undefined,
      postalCode: contact.postalCode || undefined,
      addressLocality: 'Shillong', addressRegion: 'Meghalaya', addressCountry: 'IN',
    },
    areaServed: [{ '@type': 'City', name: 'Shillong' }, { '@type': 'Country', name: 'India' }],
    sameAs: [contact.instagramUrl].filter(Boolean),
    email: contact.email || undefined,
    telephone: contact.whatsappNumber ? `+${contact.whatsappNumber.replace(/\D/g, '')}` : undefined,
    // made to order with no fixed price, so they are services, not products
    // (Google expects a price and reviews on every Product)
    makesOffer: products.filter((p) => p.visible).map((p) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: p.title, description: p.blurb } })),
  });
  // the site's own name, so Google shows "Mynséra" above the result rather than the web address
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: brand.display,
    alternateName: [brand.display.normalize('NFD').replace(/\p{Diacritic}/gu, ''), brand.formerly].filter((n) => n && n !== brand.display),
    url: Astro.site?.toString(),
  });
}
if (page === 'pricing' && pricing.faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: pricing.faqs.map((f) => ({
      '@type': 'Question', name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}
const chat = WHATSAPP_ICON;
const wa = whatsappLink(contact, fill(settings.whatsapp.message, { brand: brand.display }));
---
<!doctype html>
<html lang="en" data-page={page}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
  <meta name="theme-color" content="#FBF5EC" />
  {page === '404' || page === 'pay' ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={brand.display} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${brand.display}: ${brand.tagline}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Jost:wght@300;400;500;600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Jost:wght@300;400;500;600&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Jost:wght@300;400;500;600&display=swap" /></noscript>
  <script is:inline>
    // Runs before first paint. The loader only shows on the first visit of a
    // session, never on the quote page and never for reduced motion. If the
    // motion bundle hasn't started within 4.5s (blocked, offline, crashed),
    // everything is revealed so the page can never be trapped.
    (function () {
      var d = document.documentElement, seen = false;
      d.classList.add('js');
      try { seen = sessionStorage.getItem('myn-intro') === '1'; } catch (e) {}
      var force = null;
      try { force = new URLSearchParams(location.search).get('motion') || sessionStorage.getItem('myn-motion'); } catch (e) {}
      var reduce = force ? force === 'off' : window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!seen && !reduce && d.dataset.page !== 'quote') d.classList.add('has-loader', 'is-loading');
      setTimeout(function () {
        if (!window.__mynMotion) d.classList.remove('js', 'has-loader', 'is-loading');
      }, 4500);
    })();
  </script>
</head>
<body>
  <a class="sr-only" href="#main">{labels.skipToContent}</a>

  <div class="loader" id="loader" aria-hidden="true">
    <div class="loader__panels"><span></span><span></span><span></span><span></span><span></span></div>
    <div class="loader__inner">
      <p class="loader__word"><Wordmark split /></p>
      <div class="loader__bar"><i></i></div>
      <div class="loader__meta"><span>{brand.showFormerly ? `${brand.formerlyLabel} ${brand.formerly}` : brand.tagline.split(",")[0]}</span><span>{contact.location.split(",")[0]}</span></div>
    </div>
  </div>

  <div class="cursor" id="cursor" aria-hidden="true"><span class="cursor__dot"></span><span class="cursor__ring"></span><span class="cursor__label"></span></div>
  <div class="progress" aria-hidden="true"><i id="progressBar"></i></div>

  {isHome && settings.ticker.length > 0 && (
    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        {[0, 1].map(() => settings.ticker.map((t) => <><span>{t}</span><em>✦</em></>))}
      </div>
    </div>
  )}

  <header class="nav" id="nav">
    <div class="nav__inner">
      <a href={url('/')} class="brand" data-cursor="Home" aria-label={`${brand.display} home`}>
        <Wordmark />
        {brand.showFormerly && <small>{brand.formerlyLabel} {brand.formerly}</small>}
      </a>
      <nav class="nav__links" aria-label="Main">
        {nav.map((n) => <a href={href(n.href)} aria-current={current(n.href)}>{n.label}</a>)}
      </nav>
      <div class="nav__tools">
        {page !== 'quote' && (
          <a href={url('quote/')} class="btn btn--quote btn--sm magnetic" data-cursor="Start">
            <span>{labels.quoteButton}</span>
          </a>
        )}
        <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="drawer"><span></span><span></span></button>
      </div>
    </div>
  </header>

  <div class="drawer" id="drawer">
    <nav class="drawer__nav" aria-label="Mobile">
      <a href={url('/')}><em>01</em>{labels.home}</a>
      {nav.map((n, i) => <a href={href(n.href)}><em>0{i + 2}</em>{n.label}</a>)}
    </nav>
    <a href={url('quote/')} class="btn btn--quote"><span>{labels.quoteButton}</span></a>
    <a href={wa} class="btn btn--wa" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={chat} /></svg><span>{settings.whatsapp.menuButton}</span></a>
    <div class="drawer__foot">
      <span>{contact.location}</span>
      <a href={contact.instagramUrl} target="_blank" rel="noopener">{contact.instagramHandle}</a>
    </div>
  </div>

  <main id="main">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="foot__top">
        <div class="foot__col" data-reveal="up">
          <h4>{footer.startTitle}</h4>
          <p>{footer.startText}</p>
          <a href={url('quote/')} class="btn btn--quote btn--sm"><span>{labels.quoteButton}</span></a>
        </div>
        <div class="foot__col" data-reveal="up">
          <h4>{footer.studioTitle}</h4>
          <a href={url('work/')}>{labels.ourWork}</a>
          <a href={url('pricing/')}>{footer.pricingLink}</a>
          <a href={href('#process')}>{labels.howItWorks}</a>
          <a href={url('privacy/')}>{footer.privacyLink}</a>
          <a href={url('terms/')}>{footer.termsLink}</a>
          {settings.payment.enabled && settings.payment.showInFooter && <a href={url('pay/')}>{settings.payment.footerLink}</a>}
        </div>
        <div class="foot__col" data-reveal="up">
          <h4>{footer.makeTitle}</h4>
          {footProducts.map((p) => <a href={url(`quote/?product=${p.id}`)}>{p.title}</a>)}
        </div>
        <div class="foot__col" data-reveal="up">
          <h4>{footer.helloTitle}</h4>
          <a href={contact.instagramUrl} target="_blank" rel="noopener">{footer.instagramLabel} {contact.instagramHandle}</a>
          <a href={wa} target="_blank" rel="noopener">{footer.whatsappLabel}</a>
          {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
          <p>{contact.location}<br />{contact.shipping}</p>
        </div>
      </div>
      <div class="foot__big" data-foot-word aria-hidden="true"><Wordmark /></div>
      <div class="foot__bar">
        <p>&copy; {new Date().getFullYear()} {brand.display}.{brand.showFormerly && ` ${brand.formerlyLabel.charAt(0).toUpperCase()}${brand.formerlyLabel.slice(1)} ${brand.formerly}.`}</p>
        <p>{footer.madeIn}</p>
      </div>
    </div>
  </footer>

  {page !== 'pay' && (
    <a href={wa} class="wafab" target="_blank" rel="noopener" aria-label={settings.whatsapp.floatingLabel}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={chat} /></svg><span>{settings.whatsapp.floatingLabel}</span>
    </a>
  )}

  {page !== 'quote' && page !== 'pay' && (
    <div class="qbar" id="qbar">
      <a href={url('quote/')} class="btn btn--quote"><span>{labels.quoteButton}</span><svg viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a>
      <a href={wa} class="qbar__wa" target="_blank" rel="noopener" aria-label={footer.whatsappLabel}><svg viewBox="0 0 24 24"><path d={chat} /></svg></a>
    </div>
  )}

  <script>
    import '../scripts/motion/main';
  </script>
</body>
</html>
