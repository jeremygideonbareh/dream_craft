---
import '../styles/base.css';
import '../styles/sections.css';
import Wordmark from '../components/Wordmark.astro';
import { loadContent } from '../content/load';
import { whatsappLink } from '../lib/site';
import { url } from '../lib/images';

const { settings, products } = await loadContent();
const { brand, contact, footer } = settings;
const nav = [
  { href: 'work/', label: 'Our work' },
  { href: '#make', label: 'What we make' },
  { href: 'pricing/', label: 'Packages' },
  { href: '#process', label: 'How it works' },
];
const footProducts = products.filter((p) => p.visible).slice(0, 4);

interface Props {
  title?: string;
  description?: string;
  page: 'home' | 'work' | 'pricing' | 'quote';
}
const { title, description = brand.description, page } = Astro.props;
const fullTitle = title ? `${title} | ${brand.display}` : `${brand.display}: ${brand.tagline}`;
const isHome = page === 'home';
const href = (h: string) => (h.startsWith('#') ? (isHome ? h : url('/' + h)) : url(h));
const current = (h: string) => (h.startsWith(page) ? 'page' : undefined);
const chat = 'M12 2.2a9.8 9.8 0 0 0-8.5 14.7L2.2 21.8l5-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.8a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.9 2c0 1.2.9 2.4 1 2.5.1.2 1.7 2.6 4.2 3.7 1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.6-.4Z';
---
<!doctype html>
<html lang="en" data-page={page}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#FBF5EC" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={brand.display} />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>
    // Runs before first paint. The loader only shows on the first visit of a
    // session, never on the quote page and never for reduced motion. If the
    // motion bundle hasn't started within 4.5s (blocked, offline, crashed),
    // everything is revealed so the page can never be trapped.
    (function () {
      var d = document.documentElement, seen = false;
      d.classList.add('js');
      try { seen = sessionStorage.getItem('myn-intro') === '1'; } catch (e) {}
      var force = null;
      try { force = new URLSearchParams(location.search).get('motion') || sessionStorage.getItem('myn-motion'); } catch (e) {}
      var reduce = force ? force === 'off' : window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!seen && !reduce && d.dataset.page !== 'quote') d.classList.add('has-loader', 'is-loading');
      setTimeout(function () {
        if (!window.__mynMotion) d.classList.remove('js', 'has-loader', 'is-loading');
      }, 4500);
    })();
  </script>
</head>
<body>
  <a class="sr-only" href="#main">Skip to content</a>

  <div class="loader" id="loader" aria-hidden="true">
    <div class="loader__panels"><span></span><span></span><span></span><span></span><span></span></div>
    <div class="loader__inner">
      <p class="loader__word"><Wordmark split /></p>
      <div class="loader__bar"><i></i></div>
      <div class="loader__meta"><span>{brand.showFormerly ? `formerly ${brand.formerly}` : brand.tagline.split(",")[0]}</span><span>{contact.location.split(",")[0]}</span></div>
    </div>
  </div>

  <div class="cursor" id="cursor" aria-hidden="true"><span class="cursor__dot"></span><span class="cursor__ring"></span><span class="cursor__label"></span></div>
  <div class="progress" aria-hidden="true"><i id="progressBar"></i></div>

  {isHome && settings.ticker.length > 0 && (
    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        {[0, 1].map(() => settings.ticker.map((t) => <><span>{t}</span><em>✦</em></>))}
      </div>
    </div>
  )}

  <header class="nav" id="nav">
    <div class="nav__inner">
      <a href={url('/')} class="brand" data-cursor="Home" aria-label={`${brand.display} home`}>
        <Wordmark />
        {brand.showFormerly && <small>formerly {brand.formerly}</small>}
      </a>
      <nav class="nav__links" aria-label="Main">
        {nav.map((n) => <a href={href(n.href)} aria-current={current(n.href)}>{n.label}</a>)}
      </nav>
      <div class="nav__tools">
        {page !== 'quote' && (
          <a href={url('quote/')} class="btn btn--quote btn--sm magnetic" data-cursor="Start">
            <span>Get a quote</span>
          </a>
        )}
        <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="drawer"><span></span><span></span></button>
      </div>
    </div>
  </header>

  <div class="drawer" id="drawer">
    <nav class="drawer__nav" aria-label="Mobile">
      <a href={url('/')}><em>01</em>Home</a>
      {nav.map((n, i) => <a href={href(n.href)}><em>0{i + 2}</em>{n.label}</a>)}
    </nav>
    <a href={url('quote/')} class="btn btn--quote"><span>Get a quote</span></a>
    <div class="drawer__foot">
      <span>{contact.location}</span>
      <a href={contact.instagramUrl} target="_blank" rel="noopener">{contact.instagramHandle}</a>
    </div>
  </div>

  <main id="main">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="foot__top">
        <div class="foot__col" data-reveal="up">
          <h4>{footer.startTitle}</h4>
          <p>{footer.startText}</p>
          <a href={url('quote/')} class="btn btn--quote btn--sm"><span>Get a quote</span></a>
        </div>
        <div class="foot__col" data-reveal="up">
          <h4>Studio</h4>
          <a href={url('work/')}>Our work</a>
          <a href={url('pricing/')}>Packages &amp; pricing</a>
          <a href={href('#process')}>How it works</a>
        </div>
        <div class="foot__col" data-reveal="up">
          <h4>We make</h4>
          {footProducts.map((p) => <a href={url(`quote/?product=${p.id}`)}>{p.title}</a>)}
        </div>
        <div class="foot__col" data-reveal="up">
          <h4>Say hello</h4>
          <a href={contact.instagramUrl} target="_blank" rel="noopener">Instagram {contact.instagramHandle}</a>
          <a href={whatsappLink(contact)} target="_blank" rel="noopener">WhatsApp</a>
          {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
          <p>{contact.location}<br />{contact.shipping}</p>
        </div>
      </div>
      <div class="foot__big" data-foot-word aria-hidden="true"><Wordmark /></div>
      <div class="foot__bar">
        <p>&copy; {new Date().getFullYear()} {brand.display}.{brand.showFormerly && ` Formerly ${brand.formerly}.`}</p>
        <p>{footer.madeIn}</p>
      </div>
    </div>
  </footer>

  {page !== 'quote' && (
    <div class="qbar" id="qbar">
      <a href={url('quote/')} class="btn btn--quote"><span>Get a quote</span><svg viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a>
      <a href={whatsappLink(contact)} class="qbar__wa" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><svg viewBox="0 0 24 24"><path d={chat} /></svg></a>
    </div>
  )}

  <script>
    import '../scripts/motion/main';
  </script>
</body>
</html>
